[Unit]
Description=anyProxy node agent
Documentation=https://github.com/anym1re/anyProxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/anyproxy-agent run
Restart=always
RestartSec=5s

# What actually bounds how many clients a node serves at once, and it was the
# stock 1024 — two descriptors a relayed connection, so about five hundred of
# them, reached long before memory mattered. Measured on a node: a held
# connection costs about 23 KB while it lives, and a listener settles at
# roughly 36 KB per busiest-moment connection once the allocator stops handing
# pages back. 16384 descriptors is therefore about eight thousand connections
# and some three hundred megabytes at rest — sixteen times the old ceiling and
# still safe beside the engine on the smallest host we support.
LimitNOFILE=16384

User=anyproxy
Group=anyproxy
DynamicUser=no
StateDirectory=anyproxy
StateDirectoryMode=0700
WorkingDirectory=/var/lib/anyproxy
Environment=ANYPROXY_AGENT_DIR=/var/lib/anyproxy
EnvironmentFile=/etc/anyproxy/agent.env

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# PrivateUsers is deliberately absent. It puts the service in a user
# namespace, and a capability held there does not let a process bind a
# privileged port in the host's network namespace: the node would answer on
# nothing. The panel's unit keeps it, because the panel needs no capability.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077

# A node answers on 443, which is below the boundary the kernel guards, and the
# engine the agent starts inherits what the agent holds. One capability is
# granted for that and nothing else: the alternative is running as root, which
# would hand every other capability over as well for the sake of one bind.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
