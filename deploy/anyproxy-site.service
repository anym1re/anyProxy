[Unit]
Description=anyProxy public links site
Documentation=https://github.com/anym1re/anyProxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/anyproxy-site
Restart=always
RestartSec=5s

User=anyproxy-site
Group=anyproxy-site
DynamicUser=no
WorkingDirectory=/
EnvironmentFile=/etc/anyproxy/site.env

# The site listens on loopback behind nginx, which ends TLS on 443. It holds
# nothing: no database, no key, no token. The feed it reads comes from the
# panel over a tunnel, and the listener for health and metrics stays on the
# loop.
Environment=ANYPROXY_SITE_BIND=127.0.0.1:8081
Environment=ANYPROXY_SITE_ADMIN_BIND=127.0.0.1:8091

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
